{
  "name": "feng-shui",
  "version": "0.1.0",
  "description": "Feng Shui (aka Morrow): calm desktop widgets for macOS",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "MORROW_DATA_DIR=./.devdata electron .",
    "native": "cd native && npx --yes node-gyp rebuild --target=$(node -p \"require('electron/package.json').version\") --dist-url=https://electronjs.org/headers",
    "postinstall": "npm run native || echo 'Feng Shui: native helper not built; the app still runs without it.'",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "selftest": "rm -rf .selftestdata && MORROW_DATA_DIR=./.selftestdata MORROW_SELFTEST=1 electron .",
    "package": "./scripts/package.sh",
    "icon": "electron scripts/make-icon.js"
  },
  "author": "jonacloud8765",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.7.0"
  },
  "productName": "Feng Shui",
  "private": true
}